# ---------------------------------------------------------------
# ELV8co — variables d'environnement
# Copiez ce fichier en .env.local (en local) et renseignez les mêmes
# valeurs dans Vercel > Project > Settings > Environment Variables.
# Ne commitez JAMAIS le fichier .env.local.
# ---------------------------------------------------------------

# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=https://elv8co.be

# SMTP one.com (send.one.com, port 465, SSL)
SMTP_HOST=send.one.com
SMTP_PORT=465
SMTP_USER=contact@elv8co.be
SMTP_PASS=

# Adresse qui reçoit les demandes du formulaire
CONTACT_TO=contact@elv8co.be

# Mesure d'audience (optionnel, désactivée par défaut).
# Valeurs possibles : vide (aucun outil), "plausible" ou "ga".
NEXT_PUBLIC_ANALYTICS_PROVIDER=
# Plausible : le domaine déclaré dans Plausible (ex. elv8co.be)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Google Analytics 4 : l'identifiant de mesure (ex. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Search Console : code de la balise meta de vérification (optionnel si vérification DNS)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
